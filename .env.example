# .env — racine du projet (copier en .env et renseigner les valeurs)
# Ce fichier .env.example est committé ; le .env réel est gitignoré.

# Mot de passe Postgres PROD — injecté par docker-compose.prod.yml (${DB_PASSWORD})
DB_PASSWORD=change-me-prod

# Mot de passe Postgres DEV — injecté par docker-compose.yml (${POSTGRES_PASSWORD})
# Doit correspondre au mot de passe du volume pgdata et au DATABASE_URL de backend/.env
POSTGRES_PASSWORD=change-me-dev
